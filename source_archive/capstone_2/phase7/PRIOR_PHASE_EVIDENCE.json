    "02": {
      "archive": "phase1_submission02_recovery.zip",
      "architecture": {
        "family": "encoder-decoder Transformer",
        "substantive_difference_from_submission01": "six-layer bidirectional encoder plus six-layer causal decoder with encoder-decoder cross-attention",
        "parameter_range": [
          50000000,
          300000000
        ],
        "encoder_layers": 6,
        "decoder_layers": 6,
        "hidden_size": 512,
        "attention_heads": 8,
        "ffn_size": 2048,
        "position_representation": "learned_absolute",
        "normalization": "pre_layer_norm",
        "activation": "gelu",
        "embedding_tying": "shared_encoder_decoder_and_output",
        "max_encoder_length": 1024,
        "max_decoder_length": 512,
        "analytical_parameter_count_at_vocab_32000": 61342976,
        "student_design_rationale": "A 512-wide 6+6 pre-norm Transformer stays above the 50M parameter floor while remaining practical on a 16 GB Kaggle GPU. Training uses 512/256-token pairs, while 1024/512 positional limits provide safer inference headroom. The bidirectional encoder can form a full-prompt legal representation, and every decoder block can retrieve it through cross-attention while preserving causal target prediction."
      },
      "model_config": {
        "architecture": "pre_norm_encoder_decoder_transformer",
        "vocab_size": 32000,
        "encoder_layers": 6,
        "decoder_layers": 6,
        "hidden_size": 512,
        "attention_heads": 8,
        "ffn_size": 2048,
        "max_encoder_length": 1024,
        "max_decoder_length": 512,
        "dropout": 0.1,
        "attention_dropout": 0.0,
        "activation": "gelu",
        "normalization": "pre_layer_norm",
        "position_representation": "learned_absolute",
        "embedding_tying": "shared_encoder_decoder_and_output",
        "layer_norm_epsilon": 1e-05,
