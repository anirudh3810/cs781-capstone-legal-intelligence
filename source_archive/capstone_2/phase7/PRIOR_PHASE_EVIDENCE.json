      },
      "completed_pretraining_steps": 12000
    },
    "03": {
      "archive": "phase1_submission03_recovery.zip",
      "architecture": {
        "family": "single-stack bidirectional-prefix / causal-continuation hybrid",
        "substantive_difference_from_submission01": "the prompt segment is bidirectional rather than globally causal",
        "substantive_difference_from_submission02": "one shared Transformer stack and one segment-aware self-attention mask; no separate encoder/decoder and no cross-attention",
        "attention_semantics": "prefix queries attend to all valid prefix keys; continuation queries attend to all valid prefix keys and continuation keys at or before the query",
        "parameter_range": [
          50000000,
          300000000
        ],
        "student_model_config": {
          "vocab_size": 25000,
          "max_sequence_length": 1280,
          "hidden_size": 384,
          "num_layers": 24,
          "num_heads": 6,
          "head_dim": 64,
          "ffn_size": 1024,
          "dropout": 0.1,
          "normalization": "pre_rms_norm",
          "activation": "swiglu",
          "position_representation": "rope",
          "tie_word_embeddings": true
        },
        "student_exact_parameter_derivation": "For V=25,000, H=384, I=1,024, L=24: tied token embedding = V*H = 9,600,000; each block = attention 4*(H*H+H) = 591,360 + SwiGLU [2*(H*I+I)+(I*H+H)] = 1,182,080 + two RMSNorm vectors 2H = 768, giving 1,774,208 per block and 42,580,992 across 24 blocks; final RMSNorm = 384; vocabulary bias = 25,000; total = 52,206,376 trainable parameters. RoPE and tied output weights add no trainable parameters.",
        "student_design_rationale": "A 384-dimensional residual stream reduces the information bottleneck while retaining a deep 24-block shared network within the parameter floor. Six heads give a conventional, tensor-core-friendly 64-dimensional head for full RoPE. Pre-RMSNorm, SwiGLU, scaled residual initialization, mixed precision, and balanced two-T4 data parallel batches are used for stable, compute-efficient scratch training."
      },
      "model_config": {
        "architecture": "rope_prefix_hybrid_transformer",
        "vocab_size": 25000,
        "max_sequence_length": 1280,
        "hidden_size": 384,
        "num_layers": 24,
        "num_heads": 6,
        "head_dim": 64,
        "ffn_size": 1024,
        "dropout": 0.1,
        "attention_dropout": 0.0,
        "normalization": "pre_rms_norm",
        "normalization_epsilon": 1e-06,
        "activation": "swiglu",
        "position_representation": "rope",
        "rotary_base": 10000.0,
        "rotary_fraction": 1.0,
        "tie_word_embeddings": true,
        "linear_bias": true,
        "initializer_std": 0.02
      },
      "completed_pretraining_steps": 10000
    },
    "04": {
      "archive": "phase1_submission04_recovery.zip",
      "architecture": {
        "family": "efficient causal local/global attention Transformer",
        "substantive_difference": "bounded local causal attention plus explicitly routed global information, grouped-query key/value sharing and a measured cache footprint",
        "position_representation": "RoPE applied to attention queries and keys",
        "tokenizer": "new 25k byte-level BPE trained on the selected official training split only; RoPE is positional encoding",
        "parameter_range": [
          50000000,
          300000000
        ],
        "student_model_config": "14 pre-RMSNorm decoder blocks, width 512, 8 query/2 KV heads, head width 64, SwiGLU width 1536, tied 25k token embeddings, RoPE, local window 256 plus every-128th causal global anchor, maximum 1536 positions",
        "student_exact_parameter_derivation": "For V=25000: embedding V*512=12,800,000; each block attention=656,640, SwiGLU=2,362,880, two RMSNorms=1,024, so 14*3,020,544=42,287,616; final norm=512 and output bias=25,000; total=55,113,128 trainable parameters. Recompute with the actual BPE size.",
        "student_design_rationale": "A 14-layer 55.1M-parameter model balances depth against T4 throughput; grouped-query sharing reduces KV cache by 4x versus 8 KV heads; local/global causal visibility retains nearby detail and sparse long-range anchors. SDPA runs full-sequence attention efficiently; bounded KV cache accelerates autoregressive generation. This AI-assisted design must be disclosed, not attested as independently student-authored.",
        "authorship_disclosure": "AI-assisted architecture and implementation; student-owned attestation remains false pending course-approved independent revision"
      },
      "model_config": {
        "vocab_size": 25000,
        "max_sequence_length": 1536,
        "hidden_size": 512,
        "num_layers": 14,
        "num_query_heads": 8,
        "num_kv_heads": 2,
        "intermediate_size": 1536,
        "local_window": 256,
        "global_stride": 128,
        "rope_base": 10000.0,
        "residual_dropout": 0.05,
        "tie_embeddings": true
      },
